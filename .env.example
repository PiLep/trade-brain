# Copy to .env.local and fill in.

# Market data
# Free key: https://eodhd.com/
EODHD_API_TOKEN=

# Auth (Better Auth) — see docs/AUTH.md
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_ALLOWED_EMAILS=pierrelepetit91@gmail.com
PASSKEY_RP_ID=localhost

# OTP email (optional in dev — OTP is logged to console without it)
RESEND_API_KEY=
EMAIL_FROM=Trade Brain <onboarding@resend.dev>

# Local dev only — bypass the OTP/invite gate and open a session by visiting
# http://localhost:3000/api/auth/dev/sign-in  (see lib/auth-dev-bypass.ts).
# Refuses to load when NODE_ENV=production. Leave EMPTY outside localhost.
DEV_AUTH_BYPASS=
DEV_AUTH_EMAIL=dev@localhost
